# Local development settings. Copy to backend/.env (git-ignored).
# The code defaults are production-safe, so DEBUG and sign-ups must be turned on here.
DEBUG=True
ALLOW_REGISTRATION=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Use PostgreSQL with Docker (host port 5433, see docker-compose.yml), or SQLite for quick local dev:
DATABASE_URL=postgres://techthrive:devpassword@localhost:5433/techthrive
# DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional, comma-separated regexes (e.g. Vercel preview URLs):
# CORS_ALLOWED_ORIGIN_REGEXES=^https://techthrive-dash-[a-z0-9-]+\.vercel\.app$

# Production (AWS Lambda) values are set by deploy/bootstrap-aws.sh; see deploy/README.md.
